# Caddy inside the `baelapps-web` container: serves the pre-rendered site on :8080.
# HTTPS and the domain names are handled by the shared edge proxy (bq-caddy), see edge-site.caddy.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv/baelapps/current
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Hashed build assets never change; pages revalidate so new deploys show straight away
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "public, max-age=0, must-revalidate"

	# /about/ → /about (the canonical form)
	@trailingSlash path_regexp trailing ^(.+)/$
	redir @trailingSlash {re.trailing.1} permanent

	# /about → /about/index.html
	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
